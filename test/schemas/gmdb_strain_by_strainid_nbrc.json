{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmdb_strain_by_strainid_nbrc",
  "type": "object",
  "required": [
    "strain",
    "taxonomy"
  ],
  "properties": {
    "strain": {
      "type": "object",
      "required": [
        "strain_id",
        "strain_name",
        "other_strain_id_list"
      ],
      "properties": {
        "strain_id": {
          "type": "string"
        },
        "strain_name": {
          "type": "string"
        },
        "other_strain_id_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "other_strain_id",
              "other_strain_link"
            ],
            "properties": {
              "other_strain_id": {
                "type": "string"
              },
              "other_strain_link": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "scientific_name",
        "taxid",
        "rank",
        "authority_name",
        "lineage"
      ],
      "properties": {
        "scientific_name": {
          "type": "string"
        },
        "taxid": {
          "type": "integer"
        },
        "rank": {
          "type": "string"
        },
        "authority_name": {
          "type": "string"
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "taxid",
              "label",
              "rank"
            ],
            "properties": {
              "uri": {
                "type": "string"
              },
              "taxid": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "label": {
                "type": "string"
              },
              "rank": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
