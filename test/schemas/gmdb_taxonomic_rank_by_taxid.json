{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmdb_taxonomic_rank_by_taxid",
  "type": "object",
  "required": [
    "scientific_name",
    "taxid",
    "rank",
    "authority_name",
    "lineage"
  ],
  "properties": {
    "scientific_name": {
      "type": "string"
    },
    "taxid": {
      "type": "string"
    },
    "rank": {
      "type": "string"
    },
    "authority_name": {
      "type": "string"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "label",
          "uri",
          "taxid"
        ],
        "properties": {
          "rank": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "taxid": {
            "type": "string"
          }
        }
      }
    }
  }
}
